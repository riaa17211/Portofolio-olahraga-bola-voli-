    <script>
        // Logika untuk menu navigasi responsif (Hamburger Menu)
        const navSlide = () => {
            const burger = document.querySelector('.burger');
            const nav = document.querySelector('.nav-links');
            const navLinks = document.querySelectorAll('.nav-links li');

            burger.addEventListener('click', () => {
                // Tampilkan menu
                nav.classList.toggle('nav-active');
                // Animasikan ikon burger
                burger.classList.toggle('toggle');
            });

            // Tutup menu saat link diklik (khusus mode mobile)
            navLinks.forEach(link => {
                link.addEventListener('click', () => {
                    nav.classList.remove('nav-active');
                    burger.classList.remove('toggle');
                });
            });
        }

        // Efek Navbar transparan berubah warna saat di-scroll ke bawah
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (window.scrollY > 50) {
                nav.style.backgroundColor = 'rgba(13, 17, 23, 1)'; // Warna solid
            } else {
                nav.style.backgroundColor = 'rgba(13, 17, 23, 0.95)'; // Sedikit transparan
            }
        });

        // Jalankan fungsi
        navSlide();
    </script>
